[Unit]
Description=Takaneko automatic incremental backup scheduler
After=network-online.target postgresql.service takaneko.service
[Service]
Type=oneshot
User=takanekowork
Group=takaneko-read
SupplementaryGroups=takaneko-control
WorkingDirectory=/opt/takaneko/current
ExecStart=/usr/bin/python3 /opt/takaneko/current/server/worker.py --schedule
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
MemoryMax=128M
